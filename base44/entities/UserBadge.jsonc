{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "badge_name": {
      "type": "string"
    },
    "badge_description": {
      "type": "string"
    },
    "badge_icon_url": {
      "type": "string"
    },
    "badge_color": {
      "type": "string",
      "default": "#046B67"
    },
    "count": {
      "type": "number",
      "default": 1,
      "description": "Number of times awarded"
    }
  },
  "required": [
    "user_email",
    "badge_name"
  ]
}