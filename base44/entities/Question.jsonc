{
  "name": "Question",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "Question text"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "true_false",
        "essay"
      ],
      "description": "Question type"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Answer options for MC"
    },
    "correct_answer": {
      "type": "string",
      "description": "Correct answer"
    },
    "points": {
      "type": "number",
      "description": "Points value"
    },
    "day_number": {
      "type": "number",
      "description": "Competition day (1-29)"
    },
    "time_limit": {
      "type": "number",
      "description": "Time limit in seconds",
      "default": 90
    },
    "publish_date": {
      "type": "string",
      "description": "Date to publish (YYYY-MM-DD)"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed"
      ],
      "default": "draft"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image attached to question"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "contestants",
        "guests",
        "specific"
      ],
      "default": "all",
      "description": "\u0645\u0646 \u064a\u0638\u0647\u0631 \u0644\u0647 \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "target_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0631\u064a\u062f \u0644\u0645\u0646 \u064a\u0638\u0647\u0631 \u0644\u0647\u0645 \u0627\u0644\u0633\u0624\u0627\u0644 \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 specific"
    }
  },
  "required": [
    "text",
    "type",
    "correct_answer",
    "day_number"
  ]
}