{
  "name": "Answer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "Reference to Question"
    },
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User display name"
    },
    "user_answer": {
      "type": "string",
      "description": "The answer given"
    },
    "is_correct": {
      "type": "boolean",
      "description": "Whether answer is correct"
    },
    "points_earned": {
      "type": "number",
      "description": "Points earned"
    },
    "time_taken": {
      "type": "number",
      "description": "Time taken in seconds"
    },
    "day_number": {
      "type": "number",
      "description": "Competition day"
    },
    "graded": {
      "type": "boolean",
      "default": false,
      "description": "Whether essay was graded by admin"
    }
  },
  "required": [
    "question_id",
    "user_email",
    "user_answer",
    "day_number"
  ]
}