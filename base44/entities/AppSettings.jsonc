{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key"
    },
    "value": {
      "type": "string",
      "description": "Setting value"
    },
    "quick_challenge_image": {
      "type": "string"
    },
    "memory_challenge_image": {
      "type": "string"
    },
    "leaderboard_shield": {
      "type": "string"
    },
    "competition_start_date": {
      "type": "string"
    },
    "competition_description": {
      "type": "string",
      "description": "Competition info text"
    },
    "competition_logo": {
      "type": "string",
      "description": "Competition logo URL"
    },
    "competition_rules_url": {
      "type": "string",
      "description": "Competition rules PDF or external link URL"
    },
    "card_template": {
      "type": "string",
      "description": "Shared card background template URL"
    },
    "streak_logo": {
      "type": "string",
      "description": "Streak share card logo URL"
    },
    "leaderboard_hidden": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u062e\u0641\u0627\u0621 \u0644\u0648\u062d\u0629 \u0627\u0644\u0635\u062f\u0627\u0631\u0629 \u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0639"
    }
  },
  "required": [
    "key"
  ]
}