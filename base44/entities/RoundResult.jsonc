{
  "name": "RoundResult",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0625\u062c\u0627\u0628\u0627\u062a \u0627\u0644\u0635\u062d\u064a\u062d\u0629"
    },
    "time_taken": {
      "type": "number",
      "description": "\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0633\u062a\u063a\u0631\u0642 \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a"
    },
    "total_questions": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "user_email",
    "score",
    "time_taken"
  ]
}