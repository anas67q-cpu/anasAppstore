{
  "name": "NotificationPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "notify_new_question": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0646\u0628\u064a\u0647 \u0639\u0646\u062f \u0646\u0632\u0648\u0644 \u0633\u0624\u0627\u0644 \u062c\u062f\u064a\u062f"
    },
    "notify_reminder": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0630\u0643\u064a\u0631 \u0642\u0628\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u0648\u0642\u062a \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "notify_grade": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0646\u0628\u064a\u0647 \u0639\u0646\u062f \u062a\u0635\u062d\u064a\u062d \u0627\u0644\u0625\u062c\u0627\u0628\u0629"
    },
    "notify_friends": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621"
    },
    "watched_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0625\u064a\u0645\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646 \u0627\u0644\u0645\u062a\u0627\u0628\u064e\u0639\u064a\u0646"
    }
  },
  "required": [
    "user_email"
  ]
}